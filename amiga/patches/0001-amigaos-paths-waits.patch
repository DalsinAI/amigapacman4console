+#ifdef __amigaos__
+/* AmigaOS: the same pause, but the keys are waited for until it ends
+   (curses' timeout) instead of read in a loop that keeps the CPU busy */
+void Delay() {
+	long end = acurses_ms() + SpeedOfGame, now;
+
+	GetInput();
+	while ((now = acurses_ms()) < end) {
+		timeout((int)(end - now));
+		GetInput();
+	}
+	nodelay(stdscr, TRUE);
+}
+#else
